{
  "schemaVersion": 1,
  "purpose": "Temporary, narrowly-scoped exceptions for known advisories in the Expo/Metro build toolchain. The audit script still fails closed on any high/critical advisory not listed here.",
  "reviewAfter": "2026-11-14",
  "advisories": {
