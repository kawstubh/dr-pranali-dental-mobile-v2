      "package": "braces",
      "reason": "Transitive through micromatch -> Metro file-map / Expo Metro tooling. No upstream patched braces release is available in the current lockfile audit; do not force an Expo downgrade to satisfy npm's suggested Expo 44 fix."
    },
    "https://github.com/advisories/GHSA-86w9-cpqp-85rv": {
      "package": "node-forge",
      "reason": "Transitive through @expo/code-signing-certificates -> @expo/cli. No upstream patched node-forge release is available in the current lockfile audit; do not force an Expo downgrade to satisfy npm's suggested Expo 44 fix."
    }
  }
}
