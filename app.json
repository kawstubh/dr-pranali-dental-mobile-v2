{
  "expo": {
    "name": "Dr. Pranali Dental",
    "slug": "dr-pranali-dental",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/patient-shield.svg",
    "splash": {
      "image": "./assets/patient-shield.svg",
      "resizeMode": "contain",
      "backgroundColor": "#F5F9FC"
    },
    "android": {
      "package": "com.drpranali.dental",
      "adaptiveIcon": {
        "foregroundImage": "./assets/patient-shield.svg",
        "backgroundColor": "#F5F9FC",
        "monochromeImage": "./assets/monochrome-shield.svg"
      }
    },
    "ios": {
      "bundleIdentifier": "com.drpranali.dental"
    },
    "plugins": [
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-mark.svg",
          "color": "#1677D2"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7237b92a-a286-4f47-b519-caf145a88d7d"
      }
    },
    "web": {
      "favicon": "./assets/patient-shield.svg"
    }
  }
}
