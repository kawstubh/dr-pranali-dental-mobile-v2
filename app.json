{
  "expo": {
    "name": "Dr. Pranali Dental",
    "slug": "dr-pranali-dental",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/dr-pranali-branded-logo.png",
    "splash": {
      "image": "./assets/dr-pranali-branded-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF7FB"
    },
    "android": {
      "package": "com.drpranali.dental",
      "adaptiveIcon": {
        "foregroundImage": "./assets/dr-pranali-branded-logo.png",
        "backgroundColor": "#FFF7FB",
        "monochromeImage": "./assets/dr-pranali-branded-logo.png"
      }
    },
    "ios": {
      "bundleIdentifier": "com.drpranali.dental"
    },
    "plugins": [
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin",
      {
        "expo-notifications": {
          "icon": "./assets/dr-pranali-branded-logo.png",
          "color": "#1677D2"
        }
      }
    ],
    "extra": {
      "eas": {
        "projectId": "7237b92a-a286-4f47-b519-caf145a88d7d"
      }
    },
    "web": {
      "favicon": "./assets/dr-pranali-branded-logo.png"
    }
  }
}
