{
  "expo": {
    "name": "Dr. Pranali Dental Clinic",
    "slug": "dr-pranali-dental",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/dr-pranali-branded-logo.png",
    "android": {
      "package": "com.drpranali.dental",
      "adaptiveIcon": {
        "foregroundImage": "./assets/dr-pranali-branded-logo.png",
        "backgroundColor": "#FFF7FB"
      }
    },
    "ios": {
      "bundleIdentifier": "com.drpranali.dental"
    },
    "plugins": [
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FBFF",
          "image": "./assets/dr-pranali-branded-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7237b92a-a286-4f47-b519-caf145a88d7d"
      }
    },
    "scheme": "drpranali"
  }
}
