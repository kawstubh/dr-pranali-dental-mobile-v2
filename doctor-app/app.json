{
  "expo": {
    "owner": "kaus2b",
    "name": "Dental Clinic Doctor",
    "slug": "dr-pranali-dental-doctor",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/dr-pranali-branded-logo.png",
    "android": {
      "package": "com.drpranali.dental.doctor",
      "adaptiveIcon": {
        "foregroundImage": "./assets/dr-pranali-branded-logo.png",
        "backgroundColor": "#FFF7FB"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "drpranali-doctor",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.drpranali.dental.doctor"
    },
    "extra": {
      "apiUrl": "https://dr-pranali-dental-api.onrender.com",
      "eas": {
        "projectId": "67bbd408-3b22-4a4c-8063-a2425edb4ef1"
      }
    },
    "scheme": "drpranali-doctor",
    "plugins": [
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FBFF",
          "image": "./assets/dr-pranali-branded-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
